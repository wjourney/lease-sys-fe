:8080 {
    encode zstd gzip

    handle /api/* {
        # 30 MiB files plus multipart metadata; the API enforces avatar limits.
        request_body {
            max_size 32MiB
        }
        reverse_proxy api:3001
    }

    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
